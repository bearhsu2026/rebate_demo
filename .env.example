# 複製這個檔成 .env 後填入你的值（.env 不會進 git）
# Windows: copy .env.example .env
# Mac/Linux: cp .env.example .env

# FinMind 資料來源 token（到 https://finmindtrade.com 註冊取得，免費）
# 沒填也能跑，但會受較低的免費流量限制
FINMIND_TOKEN=

# Telegram 推播（M3 才會用到，現在可留空）
# 用 @BotFather 建 bot 取得 token；chat_id 可用 @userinfobot 查
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Web 介面登入（之後 UI 加認證用）
WEB_USERNAME=admin
WEB_PASSWORD=change-me

# 資料庫/資料存放位置（預設專案下的 data/）
# 本機 Windows 不用改；NAS Docker 會設成 /app/data
# DATA_DIR=data

TZ=Asia/Taipei
